[Unit]
Description=Docklane
After=network.target docker.service
Wants=network.target

[Service]
Type=simple
User=docker-manager
Group=docker-manager
SupplementaryGroups=docker
Environment=DM_CONFIG=/etc/docker-manager/config.json
Environment=PATH=/usr/local/lib/docklane/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/bin/docklane
WorkingDirectory=/var/lib/docker-manager
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
SendSIGKILL=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
